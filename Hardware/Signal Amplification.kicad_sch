	)
	(text "Buffer\nCan still add more filtering \nin feedback of this buffer"
		(exclude_from_sim no)
		(at 87.884 101.092 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify top)
		)
		(uuid "09f7c8e5-357e-4518-83bd-2df4339e5295")
	)
	(text "Capacitors C9 to C13 are decoupling capacitors and are less\ninfluential so these can be of more noisy types like X7R. "
		(exclude_from_sim no)
		(at 203.962 38.608 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1dbb13e5-6130-47c1-93f2-2fcfd7ddcddd")
	)
	(text "Buffered reference\nOutput=(3.3V)/2=1.65V\nFc≈9.7...Hz -3dB"
		(exclude_from_sim no)
		(at 123.952 28.702 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "38e11dca-086b-40d4-b7dd-4ce8c7303249")
	)
	(text "C10 through C12 are for each Amplifier\nC9 and C13 are bulk for the entire analog circuit"
		(exclude_from_sim no)
		(at 198.628 62.992 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "403677ee-6b30-4e8f-8537-d8d399778894")
	)
	(text "The system can be simplified to \na first order 20Hz High-Pass filter and \na second order 5kHz Low-Pass filter with\na gain of -60. "
		(exclude_from_sim no)
		(at 97.028 85.852 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "42f5c488-e7f6-495f-9140-f1a9665f36ac")
	)
	(text "High-Pass\n~20Hz\n19.4...Hz"
		(exclude_from_sim no)
		(at 123.444 110.49 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5f9cb3fb-6eba-45be-a43f-d411b2578f4d")
	)
	(text "The capacitors in the signal-path on this sheet, C4 to C8, \nshould be non piezoelectric types like NP0-MLCC's or tantalum. "
		(exclude_from_sim no)
		(at 163.83 83.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "982e2faf-8764-4a74-9d43-605ee1966447")
	)
	(text "Low-Pass\n~5kHz\n4.82...kHz"
		(exclude_from_sim no)
		(at 189.992 109.728 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ba5a9303-041a-4572-8ff5-bb709da8f508")
	)
	(text "Low-Pass and Bias to 1.65V\n~5kHz\n4.97...kHz"
